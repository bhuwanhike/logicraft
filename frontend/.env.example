# Copy to .env and fill in. .env is git-ignored; this file is not.

# Backend API base for local development. The Vite dev proxy forwards this
# relative path to VITE_DEV_API_TARGET below (the Spring Boot context path from
# application.yml). Deployment doesn't use this file: `vite build` loads
# .env.production, which is committed and carries the deployed URL.
VITE_API_BASE=/api/v1

# Dev server only. Read by vite.config.ts (in Node) to pick the listen port and
# the address /api/v1 is proxied to. Neither reaches the shipped bundle.
VITE_DEV_PORT=5173
VITE_DEV_API_TARGET=http://localhost:8080

# Google Maps JavaScript API — browser key.
# Console: https://console.cloud.google.com/apis/credentials
#
# 1. Enable "Maps JavaScript API" for the project.
# 2. Create an API key of type "Browser".
# 3. Restrict it: "HTTP referrers (web sites)" -> localhost + your domains.
#    Do NOT use an IP restriction, and do not lift the restriction for testing;
#    a key in a shipped JS bundle is public by definition, and referrer
#    restriction is the only control that matters.
#
# Leave blank to run without a real map: the fleet panel keeps its existing
# empty state instead of rendering a grey tile void.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Only needed for AdvancedMarkerElement / styled (cloud-based)
# markers. Leave blank to use the classic overlay marker, which works with a
# plain key and no extra console configuration.
VITE_GOOGLE_MAPS_MAP_ID=

# ── runtime override ──────────────────────────────────────────────────
# VITE_* values are compiled into the bundle, so changing one requires a rebuild.
# To point an already-built deployment at a different API or Maps key, edit
# public/config.js (shipped as dist/config.js) instead — its values win over the
# build-time ones. See that file for details. It is public: never put a secret
# in it.

