# Production build defaults, loaded by `vite build` (mode=production).
#
# This file is committed, unlike `.env`, so the deployed API URL lives in the
# repository rather than in application code. A real environment variable set on
# the build host (for example a static site's Environment settings on Render)
# takes precedence over this file, so the URL can still be overridden per
# deployment without editing the repository.
#
# Absolute URL of the deployed API, including the Spring Boot context path
# (application.yml). The dashboard origin must be allowed by the backend's
# CORS_ALLOWED_ORIGINS.
VITE_API_BASE=https://logicraft-backend-a8v1.onrender.com/api/v1
