# Copy to .env and fill in. .env is git-ignored; this file is committed and must
# never contain a real secret.
#
# Spring Boot loads this automatically through spring.config.import in
# application.yml. Real environment variables take precedence, so the same
# values work whether they come from here or from a deployment dashboard.

# ── database ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logicraft
DB_USER=postgres
DB_PASSWORD=postgres
# Appended to the composed JDBC URL. Use for a managed provider that wants TLS:
#   DB_URL_PARAMS=?sslmode=require
DB_URL_PARAMS=
# Or skip the parts above entirely with one full URL (some providers give you
# this and only this):
#   DB_URL=jdbc:postgresql://db.example.com:5432/logicraft?sslmode=require
# DB_URL=

# ── connection pool ───────────────────────────────────────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── auth ──────────────────────────────────────────────────────────────
# Required, at least 32 bytes, no default. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
# 24 hours.
JWT_EXPIRATION_MS=86400000

# ── http ──────────────────────────────────────────────────────────────
PORT=8080
API_CONTEXT_PATH=/api/v1
# Comma-separated browser origins allowed to call the API. Never "*", because
# credentials are enabled. Add the deployed dashboard's origin here:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── logging ───────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
JPA_SHOW_SQL=false
