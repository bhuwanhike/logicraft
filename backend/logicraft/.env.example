# Copy to .env and fill in. .env is git-ignored; this file is committed and must
# never contain a real secret.
#
# Spring Boot loads this automatically through spring.config.import in
# application.yml. Real environment variables take precedence, so the same
# values work whether they come from here or from a deployment dashboard.

# ── database ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logicraft
DB_USER=postgres
DB_PASSWORD=postgres
# Appended to the composed JDBC URL. Use for a managed provider that wants TLS:
#   DB_URL_PARAMS=?sslmode=require
DB_URL_PARAMS=
# Or skip the parts above entirely with one full URL (some providers give you
# this and only this). Must use the jdbc:postgresql:// scheme:
#   DB_URL=jdbc:postgresql://db.example.com:5432/logicraft?sslmode=require
# DB_URL=

# Platform shortcut: Render/Railway/Heroku inject the linked database as
# DATABASE_URL with a postgres:// scheme. It is read automatically, but only
# when neither DB_URL nor DB_HOST above is set. Leave it out locally.
# DATABASE_URL=

# ── connection pool ───────────────────────────────────────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── auth ──────────────────────────────────────────────────────────────
# Required, at least 32 bytes, no default. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
# 24 hours.
JWT_EXPIRATION_MS=86400000

# ── http ──────────────────────────────────────────────────────────────
PORT=8080
API_CONTEXT_PATH=/api/v1
# Comma-separated browser origins allowed to call the API. Never "*", because
# credentials are enabled. Origins are matched exactly, so scheme, host and port
# all have to appear: browsing the dev server on :5174, on 127.0.0.1 instead of
# localhost, or on the LAN address the Vite startup banner prints are all
# different origins, and an unlisted one is refused with a bare 403 and no body.
# The Vite dev proxy drops the Origin header, so this only matters for requests
# that bypass the proxy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:3000

# ── logging ───────────────────────────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
JPA_SHOW_SQL=false
